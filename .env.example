# Copiá este archivo como .env.local para probar en la compu. En el servidor no hace falta: los valores por defecto son la misma web.

# Dirección de la API PHP (por defecto /api/index.php, en la misma web)
NEXT_PUBLIC_API_URL=http://localhost:8000/index.php

# La web pública: de ahí salen las fotos y videos (assets/productos/...) y los links de vendedores (por defecto /)
NEXT_PUBLIC_WEB_URL=https://launionmuebles.com.ar/
